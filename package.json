{
  "name": "landing-bang-olufsen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/images.js",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky",
    "figma:assets": "node scripts/figma-assets.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^2.0.1",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": "prettier --write"
