//- Базовий макет. Блоки: meta, title, styles, data, header, content, footer
include ../mixins/index

doctype html
html(lang="en")
  head
    block meta
      meta(charset="utf-8")
      meta(name="viewport" content="width=device-width, initial-scale=1")
    block title
      title Bang & Olufsen
    block styles
      link(rel="stylesheet" href="/src/styles/main.scss")
  body
    block data
    block header
      header.header.l-header
    main
      block content
    block footer
      footer
