//- Інлайн-SVG іконки з Figma (Icons & Logo). Колір — currentColor, розмір — стилями блоку icon.
//- Додаткові атрибути передаються через &attributes: +icon("phone")(class="x")
mixin icon(name)
  case name
    when "phone"
      svg.icon.icon--phone(
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      )&attributes(attributes)
        path(
          d="M20.01 15.38C18.78 15.38 17.59 15.18 16.48 14.82C16.13 14.7 15.74 14.79 15.47 15.06L13.9 17.03C11.07 15.68 8.42 13.13 7.01 10.2L8.96 8.54C9.23 8.26 9.31 7.87 9.2 7.52C8.83 6.41 8.64 5.22 8.64 3.99C8.64 3.45 8.19 3 7.65 3H4.19C3.65 3 3 3.24 3 3.99C3 13.28 10.73 21 20.01 21C20.72 21 21 20.37 21 19.82V16.37C21 15.83 20.55 15.38 20.01 15.38Z"
        )
    when "burger"
      //- три лінії: hover скорочує верхню й нижню стилями (без окремого файлу)
      svg.icon.icon--burger(
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      )&attributes(attributes)
        rect.icon__line.icon__line--top(x="3" y="6" width="18" height="2" rx="1")
        rect(x="3" y="11" width="18" height="2" rx="1")
        rect.icon__line.icon__line--bottom(x="3" y="16" width="18" height="2" rx="1")
    when "close"
      svg.icon.icon--close(
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      )&attributes(attributes)
        path(
          d="M19.1943 6.41714C19.6393 5.97216 19.6393 5.2507 19.1943 4.80571C18.7493 4.36073 18.0278 4.36073 17.5829 4.80571L12 10.3886L6.41714 4.80572C5.97216 4.36073 5.2507 4.36073 4.80571 4.80571C4.36073 5.2507 4.36073 5.97216 4.80571 6.41714L10.3886 12L4.80572 17.5829C4.36073 18.0278 4.36073 18.7493 4.80571 19.1943C5.2507 19.6393 5.97216 19.6393 6.41714 19.1943L12 13.6114L17.5829 19.1943C18.0278 19.6393 18.7493 19.6393 19.1943 19.1943C19.6393 18.7493 19.6393 18.0278 19.1943 17.5829L13.6114 12L19.1943 6.41714Z"
        )
    default
      - throw new Error(`Unknown icon: ${name}`)
